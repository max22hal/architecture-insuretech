        <mxCell id="g_rujQAS3lW6aiRPxUBQ-23" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;Зона доступности 1 (по регионам РФ)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
